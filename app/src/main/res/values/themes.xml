<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming (plan §6). This exists only so the launch
         window matches the app's ground colour instead of flashing white. -->
    <style name="Theme.Jarvis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
