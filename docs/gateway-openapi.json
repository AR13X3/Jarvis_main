            "type": "string",
            "format": "uuid",
            "title": "Proposal Id"
          },
          "summary": {
            "$ref": "#/components/schemas/ProposalSummary"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "rejected",
              "superseded"
            ],
            "title": "Status",
            "default": "pending"
          }
        },
        "type": "object",
        "required": [
          "proposal_id",
          "summary"
        ],
        "title": "ConfirmComponent"
      },
      "CreateSessionBody": {
        "properties": {
