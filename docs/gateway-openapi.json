            "title": "Kind",
            "default": "task"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "type": "object",
        "title": "CreateSessionBody"
      },
      "HTTPValidationError": {
