    "/sessions": {
      "get": {
        "summary": "List Sessions",
        "description": "Browsable conversation history (joy addendum \u00a72).\n\nGeneral chat is a series of conversations, not one thread \u2014 you ask about\nsomething, get pointed at a task, and that exchange is worth looking back\nat. Reopening needs nothing new: `GET /sessions/{id}/messages` already\nreturns persisted `components`, so a past disambiguation renders with its\noption buttons intact.",
        "operationId": "list_sessions_sessions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "task",
                    "general"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedSessions"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Session",
        "description": "Get-or-create for a task binding: a task has exactly one session and\nreopening it is the normal path, so this no longer 409s on the second call.\nSee `agentrepo.create_session`.",
        "operationId": "create_session_sessions_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
