  "components": {
    "schemas": {
      "AgentResponse": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "components": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ConfirmComponent"
                },
                {
                  "$ref": "#/components/schemas/TaskOptionsComponent"
                },
                {
                  "$ref": "#/components/schemas/NewTaskComponent"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "confirm": "#/components/schemas/ConfirmComponent",
                  "new_task": "#/components/schemas/NewTaskComponent",
                  "task_options": "#/components/schemas/TaskOptionsComponent"
                }
              }
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AgentResponse",
        "description": "Structured, never bare text \u2014 the app renders cards and buttons."
      },
      "CancelTaskBody": {
        "properties": {
          "confirm": {
            "type": "boolean",
            "title": "Confirm",
            "default": false
          },
          "scope": {
            "type": "string",
            "enum": [
              "occurrence",
              "series"
            ],
            "title": "Scope",
            "default": "series"
          }
        },
        "type": "object",
        "title": "CancelTaskBody"
      },
      "ConfirmComponent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "confirm",
            "title": "Type",
            "default": "confirm"
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Proposal Id"
          },
          "summary": {
            "$ref": "#/components/schemas/ProposalSummary"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "rejected",
              "superseded"
            ],
            "title": "Status",
            "default": "pending"
          }
        },
        "type": "object",
        "required": [
          "proposal_id",
          "summary"
        ],
        "title": "ConfirmComponent"
      },
      "CreateSessionBody": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "general"
            ],
            "title": "Kind",
            "default": "task"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "type": "object",
        "title": "CreateSessionBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "components": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ConfirmComponent"
                },
                {
                  "$ref": "#/components/schemas/TaskOptionsComponent"
                },
                {
                  "$ref": "#/components/schemas/NewTaskComponent"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "confirm": "#/components/schemas/ConfirmComponent",
                  "new_task": "#/components/schemas/NewTaskComponent",
                  "task_options": "#/components/schemas/TaskOptionsComponent"
                }
              }
            },
            "type": "array",
            "title": "Components"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "created_at"
        ],
        "title": "Message"
      },
      "NewTaskComponent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "new_task",
            "title": "Type",
            "default": "new_task"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "Set this up"
          },
          "seed": {
            "type": "string",
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "seed"
        ],
        "title": "NewTaskComponent",
        "description": "A way out of a general session that was asked to create something.\n\nA general session has no create tool and correctly declines \u2014 but that\nleaves the user having already said what they wanted, with nowhere to go.\nThe app renders this as a button that opens a NEW unbound session and sends\n`seed` immediately, so nothing is retyped (joy addendum \u00a74).\n\nThe invariant is untouched: this session still creates nothing, and the new\nsession binds only on confirmation. Seeding skips the typing, not the\nconfirmation."
      },
      "Ok": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          }
        },
        "type": "object",
        "title": "Ok"
      },
      "PagedMessages": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "messages",
          "has_more"
        ],
        "title": "PagedMessages"
      },
      "PagedSessions": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionSummary"
            },
            "type": "array",
            "title": "Sessions"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "sessions",
          "page",
          "has_more"
        ],
        "title": "PagedSessions"
      },
      "PagedTasks": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
