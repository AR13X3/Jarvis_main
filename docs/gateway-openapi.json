                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/options": {
      "get": {
        "summary": "Redeem Options",
        "description": "\"Show more\" on a disambiguation list (joy A3, 2026-08-20).\n\nA pure read: it appends nothing to the transcript and calls no model. The\nalternative was redeeming the cursor through `POST /messages`, which would\nappear as something the user said and spend a model call to page a list the\nserver already has.\n\nThe cursor carries the search, so this holds no state between calls.",
        "operationId": "redeem_options_sessions__session_id__options_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
