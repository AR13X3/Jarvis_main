        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "components": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ConfirmComponent"
                },
                {
                  "$ref": "#/components/schemas/TaskOptionsComponent"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "confirm": "#/components/schemas/ConfirmComponent",
                  "task_options": "#/components/schemas/TaskOptionsComponent"
                }
              }
            },
            "type": "array",
            "title": "Components"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "created_at"
        ],
        "title": "Message"
      },
